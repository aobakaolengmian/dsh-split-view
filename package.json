{
  "name": "@wxysskd/dsh-split-view",
  "version": "1.4.4",
  "type": "module",
  "description": "Split-screen Conversation View for DeepSeek Harness: arrange live sessions side by side, in a 2x2 grid, or a 3x3 grid; drag sessions in from the sidebar, including the current one.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "author": "wxysskd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aobakaolengmian/dsh-split-view.git"
  },
  "homepage": "https://github.com/aobakaolengmian/dsh-split-view",
  "bugs": {
    "url": "https://github.com/aobakaolengmian/dsh-split-view/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "split-view",
    "panes",
    "layout",
    "grid",
    "conversation",
    "multiplexer"
  ],
  "publishConfig": {
    "access": "public"
  }
}
